{
  "schema_version": 1,
  "meta": {
    "name": "学位论文通用示例",
    "source": "manual",
    "notes": "常见中文硕士论文格式的示例方案，可导入后按需修改"
  },
  "page": {
    "paper": "A4",
    "orientation": "portrait",
    "margins": {
      "top_cm": 2.54,
      "bottom_cm": 2.54,
      "left_cm": 3.0,
      "right_cm": 2.5,
      "header_cm": 1.5,
      "footer_cm": 1.75
    }
  },
  "styles": {
    "body_text": {
      "font_cn": "宋体",
      "font_en": "Times New Roman",
      "size_pt": 12,
      "alignment": "justify",
      "line_spacing": {"mode": "multiple", "value": 1.5},
      "first_line_indent": {"unit": "chars", "value": 2}
    },
    "heading_1": {
      "font_cn": "黑体",
      "font_en": "Times New Roman",
      "size_pt": 15,
      "bold": false,
      "alignment": "center",
      "line_spacing": {"mode": "multiple", "value": 1.5},
      "space_before_pt": 24,
      "space_after_pt": 18,
      "outline_level": 0,
      "keep_with_next": true,
      "page_break_before": true
    },
    "heading_2": {
      "font_cn": "黑体",
      "font_en": "Times New Roman",
      "size_pt": 14,
      "bold": false,
      "alignment": "left",
      "line_spacing": {"mode": "multiple", "value": 1.5},
      "space_before_pt": 13,
      "space_after_pt": 13,
      "outline_level": 1,
      "keep_with_next": true
    },
    "heading_3": {
      "font_cn": "黑体",
      "font_en": "Times New Roman",
      "size_pt": 12,
      "bold": false,
      "alignment": "left",
      "line_spacing": {"mode": "multiple", "value": 1.5},
      "space_before_pt": 12,
      "space_after_pt": 6,
      "outline_level": 2,
      "keep_with_next": true
    },
    "abstract": {
      "font_cn": "黑体",
      "font_en": "Times New Roman",
      "size_pt": 15,
      "alignment": "center",
      "space_before_pt": 12,
      "space_after_pt": 12
    },
    "keywords": {
      "font_cn": "黑体",
      "font_en": "Times New Roman",
      "size_pt": 12,
      "alignment": "left",
      "line_spacing": {"mode": "multiple", "value": 1.5}
    },
    "caption_figure": {
      "font_cn": "宋体",
      "font_en": "Times New Roman",
      "size_pt": 10.5,
      "alignment": "center",
      "space_before_pt": 6,
      "space_after_pt": 12
    },
    "caption_table": {
      "font_cn": "宋体",
      "font_en": "Times New Roman",
      "size_pt": 10.5,
      "alignment": "center",
      "space_before_pt": 6,
      "space_after_pt": 6
    },
    "reference": {
      "font_cn": "宋体",
      "font_en": "Times New Roman",
      "size_pt": 10.5,
      "alignment": "justify",
      "line_spacing": {"mode": "multiple", "value": 1.25}
    },
    "en_title": {
      "font_cn": "Times New Roman",
      "font_en": "Times New Roman",
      "size_pt": 15,
      "bold": true,
      "alignment": "center"
    },
    "en_abstract": {
      "font_cn": "Times New Roman",
      "font_en": "Times New Roman",
      "size_pt": 12,
      "alignment": "justify",
      "line_spacing": {"mode": "multiple", "value": 1.5}
    }
  },
  "numbering": {
    "heading_scheme": {
      "levels": [
        {"level": 1, "style": "heading_1", "text": "第%1章", "num_fmt": "chinese_counting", "suffix": "space"},
        {"level": 2, "style": "heading_2", "text": "%1.%2", "num_fmt": "decimal", "suffix": "space"},
        {"level": 3, "style": "heading_3", "text": "%1.%2.%3", "num_fmt": "decimal", "suffix": "space"}
      ]
    }
  },
  "tables": {
    "repeat_header": true,
    "cant_split_rows": true,
    "cell_style": {"font_cn": "宋体", "font_en": "Times New Roman",
                   "size_pt": 10.5, "alignment": "center"}
  },
  "header_footer": {
    "header": {
      "enabled": true,
      "content": "XX大学硕士学位论文",
      "align": "center",
      "font": {"font_cn": "宋体", "size_pt": 9},
      "different_first": false,
      "different_odd_even": false
    },
    "footer": {
      "enabled": true,
      "page_number": {"position": "center", "format": "第 {page} 页 共 {pages} 页", "start_at": 1}
    },
    "body_starts_new_section": true
  },
  "toc": {
    "levels": 3,
    "leader": "dot",
    "page_number_align": "right"
  },
  "caption": {
    "figure_pattern": "图{chap}-{seq}",
    "table_pattern": "表{chap}-{seq}",
    "position_figure": "below",
    "position_table": "above",
    "detect_patterns": ["^图\\s*\\d", "^表\\s*\\d", "^Fig", "^Figure\\s*\\d", "^Table\\s*\\d"]
  },
  "skeleton": [
    {"type": "cover", "text": "（论文题目）"},
    {"type": "abstract", "text": "摘  要"},
    {"type": "body_text", "text": ""},
    {"type": "keywords", "text": "关键词：；；"},
    {"type": "toc_field"},
    {"type": "heading_1", "text": "绪论"},
    {"type": "body_text", "text": ""},
    {"type": "reference", "text": "[1] "}
  ]
}
